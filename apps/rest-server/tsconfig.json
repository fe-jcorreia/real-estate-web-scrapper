{
  "extends": "@repo/tsconfig/base.tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./src",
    "outDir": "dist",
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "mocha"],
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": true,
    "declarationDir": "./dist",
    "noEmit": true,
    "paths": {
      "@api": ["./api"],
      "@api/*": ["./api/*"],
      "@core": ["./core"],
      "@core/*": ["./core/*"],
      "@data": ["./data"],
      "@data/*": ["./data/*"],
      "@domain": ["./domain"],
      "@domain/*": ["./domain/*"],
      "@env": ["./env"],
      "@env/*": ["./env/*"],
      "@model": ["./model"],
      "@model/*": ["./model/*"],
      "@test": ["./test"],
      "@test/*": ["./test/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "coverage", "*.test.ts"]
}
