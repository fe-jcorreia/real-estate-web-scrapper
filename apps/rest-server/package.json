{
  "name": "@repo/rest-server",
  "version": "1.0.0",
  "description": "Taqtile's Template Server using Node and Typescript",
  "scripts": {
    "build": "npm run clean && tsc && node esbuild.mjs",
    "clean": "rimraf dist/",
    "dev": "tsx --watch ./src/index.ts",
    "start": "node --import=./esm-module-alias-register.js dist/bundle.mjs",
    "test": "NODE_ENV=test mocha src/test/index.ts"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fastify/compress": "8.0.0",
    "@fastify/cors": "10.0.0",
    "@fastify/helmet": "12.0.0",
    "@fastify/request-context": "6.0.1",
    "@fastify/swagger": "9.0.0",
    "@fastify/swagger-ui": "5.0.1",
    "@repo/core": "0.1.0",
    "@repo/db": "0.1.0",
    "@repo/env": "0.1.0",
    "axios": "1.9.0",
    "dotenv": "16.5.0",
    "esm-module-alias": "2.2.1",
    "fastify": "5.4.0",
    "fastify-zod-openapi": "5.2.0",
    "zod": "4.0.5"
  },
  "devDependencies": {
    "@repo/tsconfig": "0.1.0",
    "@types/chai": "5.0.1",
    "@types/copyfiles": "2.4.4",
    "@types/mocha": "10.0.9",
    "@types/node": "22.2.0",
    "@types/sinon": "17.0.3",
    "chai": "5.1.2",
    "copyfiles": "2.4.1",
    "esbuild-copy-static-files": "0.1.0",
    "glob": "11.0.0",
    "mocha": "10.7.3",
    "sinon": "17.0.2",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "aliases": {
    "@api": "dist/api",
    "@core": "dist/core",
    "@data": "dist/data",
    "@domain": "dist/domain",
    "@env": "dist/env",
    "@model": "dist/model",
    "@test": "dist/test"
  }
}
