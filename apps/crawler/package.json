{
  "name": "@repo/crawler",
  "version": "1.0.0",
  "description": "Real estate web scraper - browser automation and data extraction",
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rimraf dist/",
    "dev": "tsx --watch ./src/index.ts",
    "start": "node dist/index.js",
    "test": "NODE_ENV=test mocha src/**/*.test.ts"
  },
  "dependencies": {
    "@repo/core": "0.1.0",
    "@repo/db": "0.1.0",
    "@repo/env": "0.1.0",
    "dotenv": "16.5.0",
    "playwright": "1.52.0",
    "zod": "4.0.5"
  },
  "devDependencies": {
    "@repo/tsconfig": "0.1.0",
    "@types/node": "22.2.0",
    "@types/mocha": "10.0.9",
    "@types/chai": "5.0.1",
    "chai": "5.1.2",
    "mocha": "10.7.3",
    "rimraf": "6.0.1",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
