{
  "name": "@repo/core",
  "version": "0.1.0",
  "private": true,
  "files": ["dist"],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc --project prod.tsconfig.json",
    "dev": "tsc --project prod.tsconfig.json --watch",
    "clean": "rimraf dist/",
    "test": "mocha --import=tsx src/**/**.test.ts"
  },
  "dependencies": {
    "@repo/env": "0.1.0",
    "axios": "1.9.0",
    "glob": "11.0.0",
    "express": "4.21.2",
    "i18next": "24.2.2",
    "jsonwebtoken": "9.0.2",
    "winston": "3.13.1",
    "zod": "4.0.5"
  },
  "devDependencies": {
    "@types/chai": "5.0.1",
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "9.0.7",
    "@types/mocha": "10.0.9",
    "@types/sinon": "17.0.3",
    "chai": "5.1.2",
    "mocha": "10.7.3",
    "sinon": "17.0.2",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  },
  "exports": {
    ".": "./dist/index.js",
    "./config": "./dist/config/index.js",
    "./context": "./dist/context/index.js",
    "./data": "./dist/data/index.js",
    "./error": "./dist/error/index.js",
    "./loader": "./dist/loader/index.js",
    "./localization": "./dist/localization/index.js",
    "./log": "./dist/log/index.js",
    "./pagination": "./dist/pagination/index.js",
    "./security": "./dist/security/index.js",
    "./test": "./dist/test/index.js",
    "./utils": "./dist/utils/index.js"
  },
  "typesVersions": {
    "*": {
      "config": ["dist/config/index.d.ts"],
      "context": ["dist/context/index.d.ts"],
      "data": ["dist/data/index.d.ts"],
      "error": ["dist/error/index.d.ts"],
      "loader": ["dist/loader/index.d.ts"],
      "localization": ["dist/localization/index.d.ts"],
      "log": ["dist/log/index.d.ts"],
      "pagination": ["dist/pagination/index.d.ts"],
      "security": ["dist/security/index.d.ts"],
      "test": ["dist/test/index.d.ts"],
      "utils": ["dist/utils/index.d.ts"]
    }
  },
  "engines": {
    "node": ">=14.16",
    "npm": ">=8"
  }
}
