{
  "name": "@repo/db",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "type": "module",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rimraf dist/",
    "db:codegen": "prisma generate",
    "dev": "tsc --watch",
    "migrate:deploy": "dotenv -e test.env -- prisma migrate deploy",
    "migrate:generate": "dotenv -e test.env -- prisma migrate dev",
    "migrate:reset": "dotenv -e test.env -- prisma migrate reset -f",
    "migrate:sync": "dotenv -e test.env -- prisma db push",
    "postinstall": "npm run db:codegen"
  },
  "dependencies": {
    "nanoid": "5.0.9",
    "@prisma/client": "7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "pg": "^8.13.0",
    "prisma": "7.8.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "dotenv-cli": "7.4.2",
    "typescript": "5.8.3"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/index.d.ts"
      ]
    }
  }
}
